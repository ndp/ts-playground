{
  "name": "@ndp-software/lit-md",
  "version": "0.2.0",
  "private": false,
  "description": "Literate test files that generate README.md",
  "license": "UNLICENSED -- All rights reserved. See LICENSE file.",
  "author": "Andy Peterson <andy@ndpsoftware.com>",
  "type": "module",
  "repository": {
    "type": "git",
    "url": ""},
  "keywords": [
    "literate programming",
    "markdown",
    "testing",
    "readme",
    "documentation",
    "typescript"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "bin": {
    "lit-md": "./src/cli.ts"
  },
  "files": [
    "README.md",
    "dist/**/*",
    "src/**/*"
  ],
  "exports": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "readme": "node ./src/cli.ts --describe='##' --test --typecheck --out ./README.md ./docs/README.md.test.ts",
    "test": "node --test './test/**/*.test.ts'",
    "test:watch": "node --test --watch './test/**/*.test.ts'",
    "test:acceptance": "node --test test/acceptance.test.ts",
    "test:update": "node src/cli.ts -u test/acceptance/*.ts test/acceptance/*.js",
    "typecheck": "tsc -p ./tsconfig.check.json",
    "verify": "npm run typecheck && npm run test && node ./src/cli.ts --test --typecheck --dryrun ./docs/README.md.test.ts",

    "build": "npm run build:types && npm run build:js",
    "build:types": "tsc -p tsconfig.build.json",
    "build:js": "esbuild ./index.ts --bundle --format=esm --platform=node --target=es2022 --sourcemap --outfile=./dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^25",
    "typescript": "^5"
  }
}
