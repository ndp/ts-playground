{
  "name": "@ndp-software/lit-md",
  "version": "0.1.0",
  "private": true,
  "description": "Literate test files that generate README.md",
  "license": "ISC",
  "type": "module",
  "bin": {
    "lit-md": "./src/cli.ts"
  },
  "scripts": {
    "readme": "node ./src/cli.ts --test --typecheck --out ./README.md ./docs/README.md.test.ts",
    "test": "node --test './test/**/*.test.ts'",
    "test:watch": "node --test --watch './test/**/*.test.ts'",
    "test:acceptance": "node --test test/acceptance.test.ts",
    "typecheck": "tsc -p ./tsconfig.check.json",
    "verify": "npm run typecheck && npm run test"
  }
}
