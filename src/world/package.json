{
  "name": "@ndp-software/world",
  "version": "0.1.0",
  "private": true,
  "description": "world",
  "license": "ISC",
  "type": "module",
  "files": [
  ],
  "sideEffects": false,
  "scripts": {

    "typecheck": "tsc -p config/tsconfig.check.json --noEmit",
    "test": "node --test -r ../../test/setup-jsdom.js './**/*test.ts'",
    "test:watch": "node --test --watch -r ../../test/setup-jsdom.js './**/*test.ts'",
    "verify": "npm run typecheck && npm run test",

    "build": "npm run clean && npm run build:js && npm run build:types",
    "build:js": "esbuild --outdir=./build/ --public-path=/ts-playground/build/ ./*.ts",
    "deprecated:build:types": "tsc -p ./tsconfig.types.json",


    "dev": "concurrently 'npm run build:js -- --watch' 'npm run typecheck -- --watch' 'npm run test:watch'",

    "clean": "rimraf ./build"

  }
}
