{
  "name": "@ndp-software/world",
  "version": "0.1.0",
  "private": true,
  "description": "world",
  "license": "ISC",
  "type": "module",
  "files": [
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "node --test -r ../../test/setup-jsdom.js './**/*test.ts'",
    "test:watch": "node --test --watch -r ../../test/setup-jsdom.js './**/*test.ts'",
    "verify": "npm run typecheck && npm run test",
    "build": "npm run clean && npm run build:js",
    "build:js": "npx esbuild ./components.ts --bundle --sourcemap --format=esm --outfile=build/components.js && npx esbuild ./teeny-db.ts --bundle --sourcemap --format=esm --outfile=build/teeny-db.js",
    "dev": "concurrently 'npm run build:js -- --watch' 'npm run typecheck -- --watch' 'npm run test:watch'",
    "clean": "rimraf ./build"
  },
  "dependencies": {
  },
  "sideEffects": [
    "./country-summary.ts",
    "./segmented-buttons.ts",
    "./timeline.ts",
    "./world-map.ts"
  ]
}
