{
  "name": "@ndp-software/component-bwilder",
  "version": "0.1.0",
  "private": true,
  "description": "Typed web-component builder with render lifecycle helpers",
  "license": "ISC",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {

    "readme": "tsc -p ./tsconfig.readme.json && node --test -r ../../test/setup-jsdom.js './docs/README.ts' && node ../../lit-md/src/cli.ts ./docs/README.ts --out ./README.md",

    "typecheck": "tsc -p ./tsconfig.check.json",
    "test": "node --test -r ../../test/setup-jsdom.js './**/*test.ts'",
    "test:watch": "node --test --watch -r ../../test/setup-jsdom.js './**/*test.ts'",
    "verify": "npm run typecheck && npm run test && npm run readme",

    "build": "npm run clean && npm run build:js && npm run build:types",
    "build:types": "tsc -p ./tsconfig.types.json",
    "build:js": "esbuild ./index.ts --bundle --format=esm --platform=browser --target=es2022 --sourcemap --outfile=./dist/index.js",

    "dev": "npm run clean && concurrently 'npm run build:types -- --watch' 'npm run build:js -- --watch' 'npm run typecheck -- --watch' 'npm run test:watch'",

    "clean": "rimraf ./dist",

    "pack:dry-run": "npm pack --dry-run"
  }
}
