{
  "name": "@ts-playground/component",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run clean && npm run build:js && npm run build:types",
    "build:js": "esbuild ./componentBwilder.ts --bundle --format=esm --platform=browser --target=es2022 --sourcemap --outfile=../../build/component/componentBwilder.js",
    "build:js:watch": "npm run build:js -- --watch",
    "build:types": "tsc -p ./tsconfig.types.json",
    "typecheck": "tsc -p ./tsconfig.check.json --noEmit",
    "typecheck:watch": "tsc -p ./tsconfig.check.json --noEmit --watch",
    "test": "node --test -r ../../test/setup-jsdom.js './**/*test.ts'",
    "test:watch": "node --test --watch -r ../../test/setup-jsdom.js './**/*test.ts'",
    "dev": "sh -c 'npm run test:watch & npm run typecheck:watch & npm run build:js:watch & wait'",
    "verify": "npm run typecheck && npm run test",
    "clean": "rimraf ../../build/component"
  }
}
